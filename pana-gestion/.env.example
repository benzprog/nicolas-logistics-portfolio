# ============================================================================
# PANA Gestión — variables de entorno
#
# Copiar a `.env.local` y completar. NUNCA commitear el archivo con valores
# reales: .gitignore ya lo excluye, pero conviene saberlo.
#
# Para generar los secretos:
#   openssl rand -base64 32     -> ML_TOKEN_ENCRYPTION_KEY
#   openssl rand -hex 32        -> ML_WEBHOOK_TOKEN, OAUTH_STATE_SECRET, CRON_SECRET
# ============================================================================

# --- Aplicación -------------------------------------------------------------
# URL pública. En desarrollo con túnel, la del túnel (Mercado Libre necesita HTTPS).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Se saltea RLS. Solo servidor: si esta clave llega al navegador, se filtra todo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Libre ----------------------------------------------------------
# developers.mercadolibre.com.ar -> Tus aplicaciones
ML_APP_ID=
ML_CLIENT_SECRET=
# Tiene que coincidir EXACTO con el Redirect URI de la aplicación.
ML_REDIRECT_URI=http://localhost:3000/api/mercadolibre/oauth/callback
# MLA Argentina, MLM México, MLB Brasil, MLU Uruguay, MLC Chile
ML_SITE_ID=MLA

# --- Secretos ---------------------------------------------------------------
# 32 bytes en base64. Cifra los tokens de Mercado Libre guardados en la base.
# Si se pierde, hay que reconectar la cuenta. Si se rota, hay que reconectar.
ML_TOKEN_ENCRYPTION_KEY=

# Viaja en la URL de notificaciones que se configura en Mercado Libre:
#   https://<dominio>/api/webhooks/mercadolibre?token=<ML_WEBHOOK_TOKEN>
# Es lo único que separa una notificación real de una inventada.
ML_WEBHOOK_TOKEN=

# Firma la cookie del flujo OAuth (protección contra CSRF).
OAUTH_STATE_SECRET=

# Autoriza al job de reconciliación. Se usa también al programar pg_cron:
#   select public.schedule_ml_reconcile('https://<dominio>', '<CRON_SECRET>');
CRON_SECRET=

# --- Desarrollo -------------------------------------------------------------
LOG_LEVEL=info
# 1 = no llamar a la API real de Mercado Libre (usa los mocks de tests/mocks).
ML_MOCK=0
